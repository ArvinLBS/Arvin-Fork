<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_Car_Register.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Image Source="car.jpg" Aspect="AspectFit" HeightRequest="150" Margin="0,0,0,20"/>
            
            <HorizontalStackLayout Spacing="20" HorizontalOptions="StartAndExpand">
                <Entry Text="{Binding Register}" x:Name="entryRegistrationNumber" Placeholder="Registreringsnummer" />
                <Label Text="Välj typ:" VerticalOptions="Center"/>

                <Picker  TextColor="DarkRed" ItemsSource="{Binding VehicleTypePicker}" SelectedItem="{Binding VehicleSelected}">
                    
                    
            </Picker>
                
            </HorizontalStackLayout>
            <Entry x:Name="entryManufacturer" Text="{Binding Manufacture}" Placeholder="Tillverkare" />
            <Entry x:Name="entryModel" Text="{Binding ModelCar}" Placeholder="Modell" />
            <Entry x:Name="EntryYearModel" Text="{Binding Yearmodel}" Placeholder="Års modell" />
            <Button Command="{Binding RegisterCarCommand}" x:Name="buttonRegister" Text="Registrera"  Margin="0,0,0,20" BackgroundColor="DarkRed"/>

            <Label Text="Kategori:" FontAttributes="Bold" />
            
            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,20" Spacing="10" >
                <RadioButton x:Name="radioAll" Content="Alla" />
                <RadioButton x:Name="radioCar" Content="Bilar" />
                <RadioButton x:Name="radioMC" Content="MC"  />
                <RadioButton x:Name="radioTruck" Content="Lastbil"  />
            </HorizontalStackLayout>

            <ListView x:Name="listViewVehicles" ItemsSource="{Binding ListViewVehicles}"  Margin="0,0,0,20"/>

            <HorizontalStackLayout HorizontalOptions="FillAndExpand" Spacing="20">
                <Entry x:Name="entrySearchRegistrationNumber" HorizontalOptions="FillAndExpand" Placeholder="Sök på registreringsnummer"></Entry>
                <Button BindingContext="{Binding SearchRegisterCar}" x:Name="buttonSearch" Text="Sök" HorizontalOptions="End" BackgroundColor="DarkRed" TextColor="White" />
            </HorizontalStackLayout>
            <!--<Label x:Name="labelSearchResult" Text="Sökresultat visas här..." TextColor="DarkRed" Margin="0,20,0,0"/>-->
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
